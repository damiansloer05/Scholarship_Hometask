# =============================================================
#  ADMISSIONS DASHBOARD — SINGLE SOURCE OF TRUTH FOR ALL CONFIG
#  Copy this file to .env and replace every placeholder value.
#  Never commit .env to version control.
# =============================================================

# -------------------------------------------------------------
# GCP — Core
# -------------------------------------------------------------
GCP_PROJECT_ID=my-gcp-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# -------------------------------------------------------------
# GitHub — Cloud Build trigger
# -------------------------------------------------------------
GITHUB_OWNER=your-github-username
GITHUB_REPO=admissions-dashboard
GITHUB_BRANCH=main

# -------------------------------------------------------------
# Domain
# api.yourdomain.com  →  GraphQL API (Cloud Run)
# app.yourdomain.com  →  Nuxt 3 UI  (Cloud Run)
# -------------------------------------------------------------
DOMAIN_ROOT=yourdomain.com
API_SUBDOMAIN=api
UI_SUBDOMAIN=app

# -------------------------------------------------------------
# Artifact Registry — Docker image names
# -------------------------------------------------------------
ARTIFACT_REGISTRY_REPO=admissions-repo
API_IMAGE_NAME=admissions-api
UI_IMAGE_NAME=admissions-ui

# -------------------------------------------------------------
# Cloud Run — service names
# -------------------------------------------------------------
API_SERVICE_NAME=admissions-api
UI_SERVICE_NAME=admissions-ui

# -------------------------------------------------------------
# Cloud SQL — PostgreSQL instance
# -------------------------------------------------------------
DB_INSTANCE_NAME=admissions-db
DB_NAME=admissions
DB_USER=admissions_user
DB_PASSWORD=replace-with-a-32-char-secure-password

# Computed connection name: GCP_PROJECT_ID:GCP_REGION:DB_INSTANCE_NAME
# Used inside Cloud Run to connect via Unix socket
DB_CONNECTION_NAME=my-gcp-project-id:us-central1:admissions-db

# Full DATABASE_URL stored in Secret Manager (production)
# Cloud Run reads this secret at runtime — do NOT hardcode in Terraform outputs
DATABASE_URL=postgresql://admissions_user:replace-with-a-32-char-secure-password@/admissions?host=/cloudsql/my-gcp-project-id:us-central1:admissions-db

# -------------------------------------------------------------
# Local development only (docker-compose)
# Override these in your local .env — never in production
# -------------------------------------------------------------
LOCAL_DB_PORT=5432
LOCAL_API_PORT=4000
LOCAL_UI_PORT=3000
LOCAL_DATABASE_URL=postgresql://admissions_user:replace-with-a-32-char-secure-password@localhost:5432/admissions
LOCAL_API_URL=http://localhost:4000/graphql
